    "dexie": "^4.4.6",
    "kanto": "file:../kanto",
    "lit": "^3.3.3",
    "lucide": "^1.43.0",
    "nuxt": "^4.5.2",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.63.0",
