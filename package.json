{
  "name": "fanka",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "nuxt generate",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && nuxt typecheck",
    "test:e2e": "playwright test",
    "build:chinese-data": "node scripts/build-simplified-set.mjs",
    "build:stroke-data": "node scripts/build-stroke-data.mjs",
    "content:fetch": "node scripts/content/fetch.mjs",
    "content:words": "node scripts/content/words.mjs",
    "content:examples": "node scripts/content/examples.mjs",
    "android:sync": "npm run build:app && cap sync android",
    "android:build": "[ -x \"$JAVA_HOME/bin/java\" ] || unset JAVA_HOME; cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && ([ -x \"$JAVA_HOME/bin/java\" ] || unset JAVA_HOME; cd android && ./gradlew bundleRelease)",
    "android:keystore": "echo 'Run, then back the file and both passwords up somewhere safe:' && echo 'keytool -genkeypair -v -keystore ~/.android/fanka-upload.jks -alias fanka-upload -keyalg RSA -keysize 2048 -validity 10000'",
    "android:run": "[ -x \"$JAVA_HOME/bin/java\" ] || unset JAVA_HOME; cd android && ./gradlew installDebug && adb shell am start -n fr.arnaudmichel.fanka/.MainActivity",
    "android:open": "cap open android",
    "android": "npm run android:sync && npm run android:build"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.117.0",
    "dexie": "^4.4.6",
    "kanto-ds": "^1.10.1",
    "lit": "^3.3.3",
    "lucide": "^1.43.0",
    "nuxt": "^4.5.2",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "hanzi-writer-data": "^2.0.1",
    "happy-dom": "^20.14.5",
    "opencc-data": "^1.4.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
