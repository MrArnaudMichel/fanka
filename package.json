{
  "name": "fanka",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "nuxt generate",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && nuxt typecheck",
    "test:e2e": "playwright test",
    "build:chinese-data": "node scripts/build-simplified-set.mjs",
    "android:sync": "npm run build:app && cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:run": "cd android && ./gradlew installDebug && adb shell am start -n fr.arnaudmichel.fanka/.MainActivity",
    "android:open": "cap open android",
    "android": "npm run android:sync && npm run android:build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
